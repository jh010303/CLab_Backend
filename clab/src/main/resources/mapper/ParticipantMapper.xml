<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.clab.participant.dao.ParticipantMapper">

    <resultMap id="participantMap" type="com.clab.participant.dto.ParticipantDto">
        <id property="id" column="participant_id"/>
        <result property="chatId" column="chat_id"/>
        <result property="name" column="name"/>
        <result property="count" column="count"/>
        <result property="averageReplyTime" column="average_reply_time"/>
        <result property="chatLength" column="chat_length"/>
    </resultMap>

    <resultMap id="participantPersonaMap" type="com.clab.participant.dto.ParticipantPersonaDto">
        <id property="id" column="participant_id"/>
        <!-- 대화 참여자 -->
        <result property="chatId" column="chat_id"/>
        <result property="chatName" column="chat_name"/>
        <result property="count" column="count"/>
        <result property="averageReplyTime" column="average_reply_time"/>
        <result property="chatLength" column="chat_length"/>
        
        <!-- 페르소나 분석 -->
        <result property="personaAnalysisId" column="persona_analysis_id"/>
        <result property="analysisSummary" column="analysis_summary"/>
        <result property="speechStyle" column="speech_style"/>
        <result property="tetoScore" column="teto_score"/>
        
        <!-- 인물상 -->
        <result property="personaId" column="persona_id"/>
        <result property="personaName" column="persona_name"/>
        <result property="description" column="description"/>
        <result property="image" column="image"/>
    </resultMap>

    <!-- 전체 조회 -->
    <select id="findAll" resultMap="participantMap">
        SELECT
            id,
            chat_id,
            name,
            count,
            average_reply_time,
            chat_length
        FROM participant
    </select>

    <!-- 단건 조회 -->
    <select id="findById"
            parameterType="int"
            resultMap="participantMap">
        SELECT
            id,
            chat_id,
            name,
            count,
            average_reply_time,
            chat_length
        FROM participant
        WHERE id = #{id}
    </select>

	<select id="findPersonaById"
    		parameterType="int"
    		resultMap="participantPersonaMap">
		SELECT 
            p.id AS participant_id,
            p.chat_id,
            p.name AS chat_name,
            p.count,
            p.average_reply_time,
            p.chat_length,
            
            pa.id AS persona_analysis_id,
            pa.analysis_summary,
            pa.speech_style,
            pa.teto_score,
            
            per.id AS persona_id,    
            per.name AS persona_name,
            per.description,
            per.image
        FROM participant p
        JOIN persona_analysis pa ON p.id = pa.participant_id
        JOIN persona per ON pa.persona_id = per.id
        WHERE p.chat_id = #{chatId}
    </select>

    <select id="findByChatId"
    		parameterType="int"
    		resultMap="participantMap">
        SELECT
            id,
            chat_id,
            name,
            count,
            average_reply_time,
            chat_length
        FROM participant p
        JOIN persona_analysis pa ON pa.
        WHERE p.chat_id = #{chatId}
    </select>

    <!-- 등록 -->
    <insert id="insert"
    parameterType="com.clab.participant.dto.ParticipantDto"
    useGeneratedKeys="true"
    keyProperty="id"
    >
        INSERT INTO participant
        (
            chat_id,
            name,
            count,
            average_reply_time,
            chat_length
        )
        VALUES
        (
            #{chatId},
            #{name},
            #{count},
            #{averageReplyTime},
            #{chatLength}
        )
    </insert>

    <!-- 삭제 -->
    <delete id="delete" parameterType="int">
        DELETE FROM participant
        WHERE id = #{id}
    </delete>

    <!-- 삭제 -->
    <delete id="deleteByChatId" parameterType="int">
        DELETE FROM participant
        WHERE chat_id = #{chatId}
    </delete>

</mapper>
